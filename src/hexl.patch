@@ -7,11 +7,20 @@

 #include <cstdlib>

+#if defined(__x86_64__) || defined(__i386__) || defined(_M_X64) \
+    || defined(_M_IX86)
+#define HEXL_CPU_X86 1
+#endif
+
+#ifdef HEXL_CPU_X86
 #include "cpuinfo_x86.h"  // NOLINT(build/include_subdir)
+#endif

 namespace intel {
 namespace hexl {

+#ifdef HEXL_CPU_X86
+
 // Use to disable avx512 dispatching at runtime
 static const bool disable_avx512dq =
     (std::getenv("HEXL_DISABLE_AVX512DQ") != nullptr);
@@ -31,5 +40,14 @@
 static const bool has_avx512vbmi2 =
     features.avx512vbmi2 && !disable_avx512vbmi2;

+#else
+
+// Non-x86 targets (e.g. arm64): no AVX512, always use native implementations.
+static const bool has_avx512dq = false;
+static const bool has_avx512ifma = false;
+static const bool has_avx512vbmi2 = false;
+
+#endif  // HEXL_CPU_X86
+
 }  // namespace hexl
 }  // namespace intel
